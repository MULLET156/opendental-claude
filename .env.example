# Settings for the DEMO gateway (npm start / Hostinger). Fake data only.
# Copy to .env (never committed) or set them in Hostinger's app settings.
# Make each key with: node gateway/cli.js new-key <module>
DEMO_KEY_DAYSHEET=
DEMO_KEY_FINDER=
DEMO_KEY_VOICE=
DEMO_KEY_NUMBERS=
# The office's time zone, so "today" in the fake office is the office's day.
TZ=America/Los_Angeles
# Optional: fix "today" to a date (yyyy-MM-dd) instead of following the calendar.
DEMO_TODAY=
# Never put OD_DEVELOPER_KEY or OD_CUSTOMER_KEY here: the demo refuses to start with them.
# (The real office gateway's settings live in gateway/.env.example.)
